// =============================================================================
// ПРИМЕР: Базовая оценка флагов с InMemoryProvider
// Что делает: регистрирует провайдера с набором флагов в памяти, читает флаги
//   всех четырёх типов, разбирает подробный результат оценки и показывает, что
//   происходит с отсутствующим флагом, неверным типом и выключенным флагом.
//
// Термины:
//   Провайдер - источник значений флагов. Приложение настраивает его один раз
//     при старте, дальше работает только с клиентом.
//   Клиент - то, через что прикладной код спрашивает значения. Методы клиента
//     никогда не выбрасывают исключений: флаги не должны ронять приложение.
//   Детали оценки - значение вместе с вариантом, причиной и кодом ошибки.
//     Значение есть всегда: при любом сбое это значение по умолчанию.
// =============================================================================

#Использовать ".."

// --- Набор флагов: обычно приходит из системы управления, здесь задан кодом ---

// Ключи флагов содержат дефисы, поэтому набор задаётся Соответствием:
// имя свойства структуры так выглядеть не может
Флаги = Новый Соответствие();
Флаги.Вставить("new-checkout", Истина);
Флаги.Вставить("максимум-позиций", 10);
Флаги.Вставить("приветствие", "Здравствуйте");
Флаги.Вставить("тема-оформления", Новый Структура("цвет,шрифт", "светлая", "Inter"));

// Развёрнутое описание: выключенный флаг всегда отдаёт значение по умолчанию
Флаги.Вставить("экспериментальный-поиск", Новый Структура("Значение,Включен", "быстрый", Ложь));

Провайдер = Новый InMemoryProvider(Флаги);

OpenFeature.УстановитьПровайдер(Провайдер);

Сообщить("Провайдер: " + OpenFeature.МетаданныеПровайдера().Имя);
Сообщить("Состояние: " + OpenFeature.СостояниеПровайдера());
Сообщить("");

// --- Клиент: домен попадает в метаданные и виден хукам ---

Клиент = OpenFeature.ПолучитьКлиента("магазин");

Сообщить("Домен клиента: " + Клиент.Метаданные().Домен);
Сообщить("");

// --- Четыре типа значений, у каждого своё значение по умолчанию ---

Сообщить("new-checkout            = " + Клиент.ПолучитьЛогическое("new-checkout", Ложь));
Сообщить("максимум-позиций        = " + Клиент.ПолучитьЧисло("максимум-позиций", 5));
Сообщить("приветствие             = " + Клиент.ПолучитьСтроку("приветствие", "Привет"));

Тема = Клиент.ПолучитьОбъект("тема-оформления", Новый Структура("цвет", "тёмная"));
Сообщить("тема-оформления.цвет    = " + Тема.цвет);
Сообщить("");

// --- Подробный результат: почему получено именно это значение ---

Детали = Клиент.ПолучитьЛогическоеСДеталями("new-checkout", Ложь);

Сообщить("Ключ:     " + Детали.КлючФлага);
Сообщить("Значение: " + Детали.Значение);
Сообщить("Причина:  " + Детали.Причина);
Сообщить("Ошибка:   " + Детали.ЭтоОшибка());
Сообщить("");

// --- Отсутствующий флаг: значение по умолчанию и код ошибки ---
// Исключения нет: приложение продолжает работать так, будто флаг выключен.

Детали = Клиент.ПолучитьЛогическоеСДеталями("флага-нет", Истина);

Сообщить("Значение:  " + Детали.Значение);
Сообщить("Причина:   " + Детали.Причина);
Сообщить("Код:       " + Детали.КодОшибки);
Сообщить("Сообщение: " + Детали.СообщениеОбОшибке);
Сообщить("Это FLAG_NOT_FOUND: " + (Детали.КодОшибки = OpenFeatureErrorCode.ФлагНеНайден()));
Сообщить("");

// --- Неверный тип: значение не приводится молча ---

Детали = Клиент.ПолучитьЧислоСДеталями("приветствие", 0);

Сообщить("Значение:  " + Детали.Значение);
Сообщить("Код:       " + Детали.КодОшибки);
Сообщить("Сообщение: " + Детали.СообщениеОбОшибке);
Сообщить("");

// --- Выключенный флаг: причина отличается от ошибки ---

Детали = Клиент.ПолучитьСтрокуСДеталями("экспериментальный-поиск", "обычный");

Сообщить("Значение: " + Детали.Значение);
Сообщить("Причина:  " + Детали.Причина);
Сообщить("Ошибка:   " + Детали.ЭтоОшибка());
Сообщить("Это DISABLED: " + (Детали.Причина = OpenFeatureReason.Выключено()));
Сообщить("");

// --- Набор флагов меняется на лету ---

Провайдер.УстановитьФлаг("new-checkout", Ложь);
Провайдер.УдалитьФлаг("приветствие");

Сообщить("new-checkout после правки = " + Клиент.ПолучитьЛогическое("new-checkout", Истина));
Сообщить("Флагов в наборе: " + Провайдер.Флаги().Количество());
Сообщить("");

// --- До регистрации провайдера работает заглушка ---
// Изолированный экземпляр API не трогает глобальное состояние: он нужен
// в тестах и там, где в одном процессе живут несвязанные приложения.

Изолированный = OpenFeature.СоздатьИзолированныйЭкземпляр();
БезПровайдера = Изолированный.ПолучитьКлиента();

Сообщить("Провайдер по умолчанию: " + Изолированный.МетаданныеПровайдера().Имя);
Сообщить("Причина: " + БезПровайдера.ПолучитьЛогическоеСДеталями("что-угодно", Истина).Причина);
Сообщить("");

// --- Завершение сбрасывает провайдера, хуки и контекст ---

OpenFeature.Завершить();

Сообщить("После Завершить: " + OpenFeature.МетаданныеПровайдера().Имя);
