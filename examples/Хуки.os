// =============================================================================
// ПРИМЕР: Хуки - вмешательство в жизненный цикл оценки
// Что делает: сам скрипт выступает хуком и протоколирует все четыре стадии
//   оценки. Показано, как хук дополняет контекст, что происходит при ошибке
//   оценки, как хуки накапливаются с трёх уровней и почему сбой хука не портит
//   уже полученное значение.
//
// Термины:
//   Хук - объект с методами До, После, ПриОшибке, Финально. Любого из них
//     может не быть: отсутствие метода не ошибка.
//   Стадии: До вызывается перед обращением к провайдеру и может дополнить
//     контекст; После - при успешной оценке; ПриОшибке - при неудачной;
//     Финально - всегда, последней.
//   Уровни регистрации: API (все клиенты), клиент, отдельный вызов. Стадия До
//     идёт от глобальных хуков к локальным, остальные стадии - в обратном
//     порядке.
//   Подсказки - произвольные данные, которые вызывающий код передаёт хукам.
// =============================================================================

#Использовать ".."

Перем Протокол;
Перем ПадатьВПосле;

// --- Реализация хука: четыре стадии, каждая пишет строку в протокол ---

Функция До(Знач Данные, Знач Подсказки) Экспорт

	Канал = Подсказки.Получить("канал");

	Протокол.Добавить("До:       флаг " + Данные.КлючФлага + ", тип " + Данные.ТипФлага
		+ ", домен " + Данные.МетаданныеКлиента.Домен
		+ ?(Канал = Неопределено, "", ", канал " + Канал));

	// Возвращённый контекст объединяется с текущим, и его атрибуты важнее
	Дополнение = Новый EvaluationContext("", Новый Структура("источник", "хук"));

	Если Канал <> Неопределено Тогда
		Дополнение.Установить("канал", Канал);
	КонецЕсли;

	Возврат Дополнение;

КонецФункции

Процедура После(Знач Данные, Знач Детали, Знач Подсказки) Экспорт

	Протокол.Добавить("После:    значение " + Детали.Значение + ", причина " + Детали.Причина);

	Если ПадатьВПосле Тогда
		ВызватьИсключение "Хук сломался";
	КонецЕсли;

КонецПроцедуры

Процедура ПриОшибке(Знач Данные, Знач Ошибка, Знач Подсказки) Экспорт

	Протокол.Добавить("ПриОшибке: " + Ошибка);

КонецПроцедуры

Процедура Финально(Знач Данные, Знач Детали, Знач Подсказки) Экспорт

	Протокол.Добавить("Финально: значение " + Детали.Значение);

КонецПроцедуры

Процедура ВывестиПротокол(Знач Пояснение)

	Сообщить(Пояснение + ", записей в протоколе: " + Протокол.Количество());

	Для Каждого Строка Из Протокол Цикл
		Сообщить("  " + Строка);
	КонецЦикла;

	Протокол.Очистить();
	Сообщить("");

КонецПроцедуры

Протокол = Новый Массив();
ПадатьВПосле = Ложь;

// --- Флаг, правило которого срабатывает только на атрибут из хука ---

Варианты = Новый Соответствие();
Варианты.Вставить("светлая", "light");
Варианты.Вставить("тёмная", "dark");

Значения = Новый Массив();
Значения.Добавить("хук");

Правила = Новый Массив();
Правила.Добавить(Новый Структура("Атрибут,Значения,Вариант", "источник", Значения, "тёмная"));

Тема = Новый Структура();
Тема.Вставить("Варианты", Варианты);
Тема.Вставить("ВариантПоУмолчанию", "светлая");
Тема.Вставить("Правила", Правила);

Флаги = Новый Соответствие();
Флаги.Вставить("тема", Тема);

Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
Экземпляр.УстановитьПровайдер(Новый InMemoryProvider(Флаги));

Клиент = Экземпляр.ПолучитьКлиента("интерфейс");

// --- Оценка без хуков: правило не срабатывает, атрибута в контексте нет ---

Сообщить("Без хука: " + Клиент.ПолучитьСтроку("тема", "нет"));
Сообщить("");

// --- Хук уровня API: работает для всех клиентов этого экземпляра ---

Экземпляр.ДобавитьХук(ЭтотОбъект);

Детали = Клиент.ПолучитьСтрокуСДеталями("тема", "нет");

Сообщить("С хуком: " + Детали.Значение + " (" + Детали.Причина + ")");
ВывестиПротокол("Успешная оценка");

// --- Ошибка оценки: вместо После вызывается ПриОшибке, Финально всё равно ---

Детали = Клиент.ПолучитьСтрокуСДеталями("флага-нет", "запасное");

Сообщить("Отсутствующий флаг: " + Детали.Значение + " (" + Детали.КодОшибки + ")");
ВывестиПротокол("Оценка с ошибкой");

// --- Подсказки: данные от вызывающего кода к хукам ---

Подсказки = Новый Соответствие();
Подсказки.Вставить("канал", "мобильное приложение");

Параметры = Новый Структура();
Параметры.Вставить("ПодсказкиХуков", Подсказки);

Клиент.ПолучитьСтрокуСДеталями("тема", "нет", , Параметры);
ВывестиПротокол("Оценка с подсказками");

// --- Три уровня регистрации: хуки накапливаются, а не заменяют друг друга ---
// Тот же объект добавлен на уровень клиента и на отдельный вызов, поэтому
// каждая стадия отработала трижды.

Клиент.ДобавитьХук(ЭтотОбъект);

ХукиВызова = Новый Массив();
ХукиВызова.Добавить(ЭтотОбъект);

Параметры = Новый Структура();
Параметры.Вставить("Хуки", ХукиВызова);

Клиент.ПолучитьСтрокуСДеталями("тема", "нет", , Параметры);
ВывестиПротокол("Хуки API, клиента и вызова");

// --- Сбой хука на стадии После не отменяет полученное значение ---
// Стадии После, ПриОшибке и Финально защищены: исключение в них не может
// испортить результат оценки.

ПадатьВПосле = Истина;

Детали = Клиент.ПолучитьСтрокуСДеталями("тема", "нет");

Сообщить("Значение при сломанном хуке: " + Детали.Значение + " (" + Детали.Причина + ")");
Сообщить("Ошибка оценки: " + Детали.ЭтоОшибка());
ВывестиПротокол("Сломанный хук");
