// =============================================================================
// ПРИМЕР: Флаги из JSON-файла - обновление без перезапуска
// Что делает: поднимает провайдера на файле examples/флаги.json, читает флаги,
//   а затем на копии файла показывает перечитывание на лету и поведение,
//   когда файл испорчен или удалён.
//
// Термины:
//   JsonFileProvider - провайдер, читающий описание флагов из файла. Формат
//     файла тот же, что понимает InMemoryProvider.
//   Перечитать - повторное чтение файла. Позволяет менять флаги, не перезапуская
//     приложение: достаточно вызвать метод по расписанию или по сигналу.
//   Состояние провайдера - NOT_READY до инициализации, READY после успешного
//     чтения, ERROR если файл не прочитан.
// =============================================================================

#Использовать ".."

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Ложь);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

// --- Провайдер на файле из состава примеров ---

ПутьКФайлу = ОбъединитьПути(ТекущийСценарий().Каталог, "флаги.json");

Провайдер = Новый JsonFileProvider(ПутьКФайлу);

Сообщить("Состояние до регистрации: " + Провайдер.Состояние());

Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
Экземпляр.УстановитьПровайдер(Провайдер);

Сообщить("Состояние после регистрации: " + Провайдер.Состояние());
Сообщить("Провайдер: " + Экземпляр.МетаданныеПровайдера().Имя);
Сообщить("Флагов прочитано: " + Провайдер.Флаги().Количество());
Сообщить("");

Клиент = Экземпляр.ПолучитьКлиента("магазин");

Сообщить("new-checkout     = " + Клиент.ПолучитьЛогическое("new-checkout", Ложь));
Сообщить("максимум-позиций = " + Клиент.ПолучитьЧисло("максимум-позиций", 5));
Сообщить("приветствие      = " + Клиент.ПолучитьСтроку("приветствие", "Привет"));
Сообщить("");

// Варианты и правила описываются в файле теми же полями, что в коде
Детали = Клиент.ПолучитьСтрокуСДеталями("тема", "light",
	Новый EvaluationContext("user-2", Новый Структура("plan", "pro")));

Сообщить("тема для pro: " + Детали.Значение + " (вариант " + Детали.Вариант + ", " + Детали.Причина + ")");

Детали = Клиент.ПолучитьСтрокуСДеталями("экспериментальный-поиск", "обычный");

Сообщить("выключенный флаг: " + Детали.Значение + " (" + Детали.Причина + ")");
Сообщить("");

// --- Обновление флагов на лету ---
// Работаем на копии в каталоге временных файлов, чтобы пример не менял
// файл из состава пакета.

Копия = ОбъединитьПути(КаталогВременныхФайлов(), "openfeature-пример-флаги.json");
КопироватьФайл(ПутьКФайлу, Копия);

Горячий = Новый JsonFileProvider(Копия);
ГорячийЭкземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
ГорячийЭкземпляр.УстановитьПровайдер(Горячий);

ГорячийКлиент = ГорячийЭкземпляр.ПолучитьКлиента();

Сообщить("До правки файла: " + ГорячийКлиент.ПолучитьЧисло("максимум-позиций", 5));

ЗаписатьФайл(Копия, "{""максимум-позиций"": 99, ""new-checkout"": false}");

Сообщить("Файл изменён, но провайдер ещё не перечитан: "
	+ ГорячийКлиент.ПолучитьЧисло("максимум-позиций", 5));

Сообщить("Перечитать: " + Горячий.Перечитать());
Сообщить("После перечитывания: " + ГорячийКлиент.ПолучитьЧисло("максимум-позиций", 5));
Сообщить("Флагов осталось: " + Горячий.Флаги().Количество());
Сообщить("");

// --- Испорченный файл не роняет приложение ---
// Провайдер переходит в ERROR, оценка отдаёт значения по умолчанию с кодом
// PARSE_ERROR, а причина видна в ПоследняяОшибка.

ЗаписатьФайл(Копия, "{ это не json ");

Сообщить("Перечитать испорченный: " + Горячий.Перечитать());
Сообщить("Состояние: " + Горячий.Состояние());
// В текст ошибки попадают подробности платформы, для вывода берём начало
Сообщить("Последняя ошибка: " + СтрРазделить(Горячий.ПоследняяОшибка(), "{")[0]);

Детали = ГорячийКлиент.ПолучитьЧислоСДеталями("максимум-позиций", 5);

Сообщить("Значение: " + Детали.Значение + " (" + Детали.КодОшибки + ")");
Сообщить("");

// --- Пропавший файл ---

УдалитьФайлы(Копия);

Сообщить("Перечитать после удаления: " + Горячий.Перечитать());
Сообщить("Состояние: " + Горячий.Состояние());
Сообщить("Последняя ошибка: " + Горячий.ПоследняяОшибка());
