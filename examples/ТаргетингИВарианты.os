// =============================================================================
// ПРИМЕР: Таргетинг и варианты - разным пользователям разные значения
// Что делает: описывает флаги с вариантами и правилами таргетинга, оценивает
//   их для трёх разных контекстов, показывает, как контекст уровня приложения
//   объединяется с контекстом вызова, и что происходит при ошибке в описании
//   вариантов.
//
// Термины:
//   Вариант - именованное значение флага. Провайдер возвращает и значение,
//     и имя варианта, поэтому в аналитику попадает «тёмная», а не «dark».
//   Правило таргетинга - условие вида «значение атрибута контекста входит
//     в список». Правила проверяются по порядку, побеждает первое совпавшее.
//   Ключ таргетинга (targetingKey) - идентификатор субъекта оценки. По нему
//     провайдеры закрепляют пользователя за вариантом.
//   Контекст оценки - данные, по которым провайдер принимает решение. Контекст
//     вызова важнее контекста приложения: он ближе к месту решения.
// =============================================================================

#Использовать ".."

Процедура ПоказатьФлаг(Знач Клиент, Знач Пояснение, Знач Ключ, Знач Контекст = Неопределено)

	Детали = Клиент.ПолучитьСтрокуСДеталями(Ключ, "нет", Контекст);

	Сообщить("  " + Пояснение + ": " + Детали.Значение
		+ " (вариант " + ?(ПустаяСтрока(Детали.Вариант), "не задан", Детали.Вариант)
		+ ", причина " + Детали.Причина + ")");

КонецПроцедуры

Функция НовоеПравило(Знач Атрибут, Знач ДопустимоеЗначение, Знач Вариант)

	Значения = Новый Массив();
	Значения.Добавить(ДопустимоеЗначение);

	Возврат Новый Структура("Атрибут,Значения,Вариант", Атрибут, Значения, Вариант);

КонецФункции

// --- Флаг темы: два варианта и два правила ---

ВариантыТемы = Новый Соответствие();
ВариантыТемы.Вставить("светлая", "light");
ВариантыТемы.Вставить("тёмная", "dark");

ПравилаТемы = Новый Массив();
ПравилаТемы.Добавить(НовоеПравило("plan", "pro", "тёмная"));
ПравилаТемы.Добавить(НовоеПравило("targetingKey", "user-42", "тёмная"));

Тема = Новый Структура();
Тема.Вставить("Варианты", ВариантыТемы);
Тема.Вставить("ВариантПоУмолчанию", "светлая");
Тема.Вставить("Правила", ПравилаТемы);

// --- Флаг языка: правило по региону из контекста приложения ---

ВариантыЯзыка = Новый Соответствие();
ВариантыЯзыка.Вставить("русский", "ru");
ВариантыЯзыка.Вставить("английский", "en");

ПравилаЯзыка = Новый Массив();
ПравилаЯзыка.Добавить(НовоеПравило("регион", "RU", "русский"));

Язык = Новый Структура();
Язык.Вставить("Варианты", ВариантыЯзыка);
Язык.Вставить("ВариантПоУмолчанию", "английский");
Язык.Вставить("Правила", ПравилаЯзыка);

Флаги = Новый Соответствие();
Флаги.Вставить("тема", Тема);
Флаги.Вставить("язык", Язык);

Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
Экземпляр.УстановитьПровайдер(Новый InMemoryProvider(Флаги));

Клиент = Экземпляр.ПолучитьКлиента("интерфейс");

// --- Три контекста: правило срабатывает по плану или по ключу таргетинга ---

Обычный = Новый EvaluationContext("user-1", Новый Структура("plan", "free"));
Платный = Новый EvaluationContext("user-2", Новый Структура("plan", "pro"));
Точечный = Новый EvaluationContext("user-42", Новый Структура("plan", "free"));

Сообщить("Флаг темы:");
ПоказатьФлаг(Клиент, "free           ", "тема", Обычный);
ПоказатьФлаг(Клиент, "pro            ", "тема", Платный);
ПоказатьФлаг(Клиент, "точечно user-42", "тема", Точечный);
ПоказатьФлаг(Клиент, "без контекста  ", "тема");
Сообщить("");

// Совпадение правила даёт причину TARGETING_MATCH, вариант по умолчанию - STATIC

// --- Контекст уровня приложения: задаётся один раз при старте ---

Экземпляр.УстановитьГлобальныйКонтекст(Новый EvaluationContext("", Новый Структура("регион", "RU")));

Сообщить("Флаг языка:");
ПоказатьФлаг(Клиент, "только контекст приложения", "язык");
ПоказатьФлаг(Клиент, "вызов переопределяет регион", "язык",
	Новый EvaluationContext("user-3", Новый Структура("регион", "EN")));
Сообщить("");

// --- Сборка контекста: методы возвращают тот же контекст ---

Контекст = Новый EvaluationContext("user-7")
	.Установить("plan", "pro")
	.Установить("страна", "RU")
	.УстановитьКлючТаргетинга("user-77");

Сообщить("Ключ таргетинга: " + Контекст.КлючТаргетинга());
Сообщить("Атрибутов: " + Контекст.Количество());
Сообщить("plan: " + Контекст.Получить("plan"));
Сообщить("Есть страна: " + Контекст.Содержит("страна"));
Сообщить("Есть город:  " + Контекст.Содержит("город"));
Сообщить("Города нет, значение по умолчанию: " + Контекст.Получить("город", "не указан"));
Сообщить("");

// --- Объединение: исходные контексты не меняются ---

Дополнение = Новый EvaluationContext("", Новый Структура("plan,город", "free", "Пермь"));
Объединённый = Контекст.Объединить(Дополнение);

Сообщить("После объединения plan: " + Объединённый.Получить("plan") + " (значение из аргумента важнее)");
Сообщить("Город: " + Объединённый.Получить("город"));
Сообщить("Исходный контекст не изменился, plan: " + Контекст.Получить("plan"));
Сообщить("");

// --- Ошибки в описании вариантов ---
// Провайдер сообщает о них кодом PARSE_ERROR, а не молчаливой подстановкой.

Сломанные = Новый Соответствие();

БезВариантаПоУмолчанию = Новый Структура();
БезВариантаПоУмолчанию.Вставить("Варианты", ВариантыТемы);

НесуществующийВариант = Новый Структура();
НесуществующийВариант.Вставить("Варианты", ВариантыТемы);
НесуществующийВариант.Вставить("ВариантПоУмолчанию", "полосатая");

Сломанные.Вставить("без-варианта-по-умолчанию", БезВариантаПоУмолчанию);
Сломанные.Вставить("несуществующий-вариант", НесуществующийВариант);

СломанныйЭкземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
СломанныйЭкземпляр.УстановитьПровайдер(Новый InMemoryProvider(Сломанные));
СломанныйКлиент = СломанныйЭкземпляр.ПолучитьКлиента();

Для Каждого Ключ Из Сломанные Цикл
	Детали = СломанныйКлиент.ПолучитьСтрокуСДеталями(Ключ.Ключ, "запасное");
	Сообщить(Ключ.Ключ + ": " + Детали.Значение + " (" + Детали.КодОшибки + ", " + Детали.СообщениеОбОшибке + ")");
КонецЦикла;
