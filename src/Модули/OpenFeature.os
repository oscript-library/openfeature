// OpenFeature - вендор-независимый API оценки фича-флагов.
// Спецификация: https://openfeature.dev/specification/
//
// Модуль представляет глобальный экземпляр API, как того требует спецификация.

Перем ГлобальныйРеестр;

// Регистрирует провайдера: инициализирует нового и завершает предыдущего.
//
// Параметры:
//   Провайдер - Произвольный - объект, реализующий контракт провайдера:
//                              Метаданные, Инициализировать, Завершить, Состояние,
//                              ВычислитьЛогическое, ВычислитьСтроку,
//                              ВычислитьЧисло, ВычислитьОбъект.
//
Процедура УстановитьПровайдер(Знач Провайдер) Экспорт

	Реестр().УстановитьПровайдер(Провайдер);

КонецПроцедуры

// Возвращаемое значение:
//   Произвольный - текущий провайдер.
//
Функция Провайдер() Экспорт

	Возврат Реестр().Провайдер();

КонецФункции

// Возвращаемое значение:
//   Структура - метаданные текущего провайдера с полем Имя.
//
Функция МетаданныеПровайдера() Экспорт

	Возврат Реестр().МетаданныеПровайдера();

КонецФункции

// Возвращаемое значение:
//   Строка - состояние провайдера: NOT_READY, READY, ERROR, STALE или FATAL.
//
Функция СостояниеПровайдера() Экспорт

	Возврат Реестр().СостояниеПровайдера();

КонецФункции

// Создаёт клиента оценки. Не выбрасывает исключений даже без провайдера.
//
// Параметры:
//   Домен - Строка - имя домена, попадает в метаданные клиента.
//
// Возвращаемое значение:
//   FeatureClient - новый клиент.
//
Функция ПолучитьКлиента(Знач Домен = "") Экспорт

	Возврат Реестр().ПолучитьКлиента(Домен);

КонецФункции

// Добавляет хук, выполняемый при каждой оценке любого клиента.
//
// Параметры:
//   Хук - Произвольный - объект с методами До, После, ПриОшибке, Финально
//                        (любой из них может отсутствовать).
//
Процедура ДобавитьХук(Знач Хук) Экспорт

	Реестр().ДобавитьХук(Хук);

КонецПроцедуры

// Устанавливает контекст оценки уровня приложения. Он объединяется
// с контекстом вызова, причём контекст вызова имеет приоритет.
//
// Параметры:
//   Контекст - EvaluationContext - глобальный контекст.
//
Процедура УстановитьГлобальныйКонтекст(Знач Контекст) Экспорт

	Реестр().УстановитьГлобальныйКонтекст(Контекст);

КонецПроцедуры

// Возвращаемое значение:
//   EvaluationContext - глобальный контекст оценки.
//
Функция ГлобальныйКонтекст() Экспорт

	Возврат Реестр().ГлобальныйКонтекст();

КонецФункции

// Завершает провайдера и сбрасывает всё состояние API: хуки, контекст,
// провайдера. После вызова снова действует провайдер-заглушка.
//
Процедура Завершить() Экспорт

	Реестр().Завершить();

КонецПроцедуры

// Создаёт независимый экземпляр API со своим провайдером, хуками и контекстом.
//
// Возвращаемое значение:
//   OpenFeatureApi - изолированный экземпляр API.
//
Функция СоздатьИзолированныйЭкземпляр() Экспорт

	Возврат Новый OpenFeatureApi();

КонецФункции

Функция Реестр()

	Если ГлобальныйРеестр = Неопределено Тогда
		ГлобальныйРеестр = Новый OpenFeatureApi();
	КонецЕсли;

	Возврат ГлобальныйРеестр;

КонецФункции
