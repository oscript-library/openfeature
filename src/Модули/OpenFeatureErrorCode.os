// Коды ошибок оценки флага.
//
// Спецификация: https://openfeature.dev/specification/types#error-code

// Значение запрошено до инициализации провайдера.
Функция ПровайдерНеГотов() Экспорт
	Возврат "PROVIDER_NOT_READY";
КонецФункции

// Флаг не найден.
Функция ФлагНеНайден() Экспорт
	Возврат "FLAG_NOT_FOUND";
КонецФункции

// Ошибка разбора данных, например конфигурации флагов.
Функция ОшибкаРазбора() Экспорт
	Возврат "PARSE_ERROR";
КонецФункции

// Тип значения флага не совпал с ожидаемым.
Функция НесоответствиеТипа() Экспорт
	Возврат "TYPE_MISMATCH";
КонецФункции

// Провайдеру нужен ключ таргетинга, но он не передан в контексте.
Функция ОтсутствуетКлючТаргетинга() Экспорт
	Возврат "TARGETING_KEY_MISSING";
КонецФункции

// Контекст оценки не удовлетворяет требованиям провайдера.
Функция НекорректныйКонтекст() Экспорт
	Возврат "INVALID_CONTEXT";
КонецФункции

// Провайдер в неустранимом состоянии ошибки.
Функция ФатальнаяОшибкаПровайдера() Экспорт
	Возврат "PROVIDER_FATAL";
КонецФункции

// Прочие ошибки.
Функция Общая() Экспорт
	Возврат "GENERAL";
КонецФункции
