// Причины, по которым получено значение флага.
//
// Спецификация: https://openfeature.dev/specification/types#resolution-reason
//
// Список не закрыт: провайдер может вернуть любую строку, если ни одна из
// перечисленных причин не описывает ситуацию точно.

// Значение статично, динамическая оценка не выполнялась.
Функция Статическое() Экспорт
	Возврат "STATIC";
КонецФункции

// Значение взято из настроек по умолчанию: динамическая оценка не выполнялась
// либо не дала результата.
Функция ПоУмолчанию() Экспорт
	Возврат "DEFAULT";
КонецФункции

// Значение получено по правилу таргетинга.
Функция СовпадениеТаргетинга() Экспорт
	Возврат "TARGETING_MATCH";
КонецФункции

// Значение получено псевдослучайным распределением, например процентной выкаткой.
Функция Распределение() Экспорт
	Возврат "SPLIT";
КонецФункции

// Значение взято из кэша.
Функция ИзКэша() Экспорт
	Возврат "CACHED";
КонецФункции

// Флаг выключен в системе управления.
Функция Выключено() Экспорт
	Возврат "DISABLED";
КонецФункции

// Причину определить не удалось.
Функция Неизвестно() Экспорт
	Возврат "UNKNOWN";
КонецФункции

// Значение может быть устаревшим.
Функция Устарело() Экспорт
	Возврат "STALE";
КонецФункции

// Значение получено в результате ошибки.
Функция Ошибка() Экспорт
	Возврат "ERROR";
КонецФункции
