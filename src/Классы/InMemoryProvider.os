// Провайдер флагов, хранящий конфигурацию в памяти.
//
// Флаг описывается либо самим значением, либо структурой с полями Варианты,
// ВариантПоУмолчанию, Включен и Правила - формат тот же, что читает
// JsonFileProvider.

Перем НаборФлагов;
Перем СостояниеПровайдера;

Процедура ПриСозданииОбъекта(Знач НачальныеФлаги = Неопределено)

	НаборФлагов = Новый Соответствие();
	СостояниеПровайдера = "NOT_READY";

	Если НачальныеФлаги <> Неопределено Тогда
		ЗаменитьФлаги(НачальныеФлаги);
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Контракт провайдера

// Возвращаемое значение:
//   Структура - метаданные провайдера с полем Имя.
//
Функция Метаданные() Экспорт

	Возврат Новый Структура("Имя", "InMemoryProvider");

КонецФункции

// Вызывается при регистрации провайдера.
//
// Параметры:
//   Контекст - EvaluationContext - глобальный контекст оценки.
//
Процедура Инициализировать(Знач Контекст = Неопределено) Экспорт

	СостояниеПровайдера = "READY";

КонецПроцедуры

// Вызывается, когда провайдер перестаёт использоваться.
//
Процедура Завершить() Экспорт

	СостояниеПровайдера = "NOT_READY";

КонецПроцедуры

// Возвращаемое значение:
//   Строка - состояние провайдера: NOT_READY, READY, ERROR, STALE или FATAL.
//
Функция Состояние() Экспорт

	Возврат СостояниеПровайдера;

КонецФункции

Функция ВычислитьЛогическое(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Возврат Вычислить_(Ключ, ЗначениеПоУмолчанию, Контекст, Тип("Булево"));

КонецФункции

Функция ВычислитьСтроку(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Возврат Вычислить_(Ключ, ЗначениеПоУмолчанию, Контекст, Тип("Строка"));

КонецФункции

Функция ВычислитьЧисло(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Возврат Вычислить_(Ключ, ЗначениеПоУмолчанию, Контекст, Тип("Число"));

КонецФункции

Функция ВычислитьОбъект(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Возврат Вычислить_(Ключ, ЗначениеПоУмолчанию, Контекст, Неопределено);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Управление набором флагов

// Заменяет весь набор флагов.
//
// Параметры:
//   НовыеФлаги - Структура, Соответствие - описание флагов.
//
Процедура ЗаменитьФлаги(Знач НовыеФлаги) Экспорт

	НаборФлагов = Новый Соответствие();

	Для Каждого Элемент Из НовыеФлаги Цикл
		НаборФлагов.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

// Добавляет или заменяет один флаг.
//
// Параметры:
//   Ключ     - Строка - ключ флага.
//   Описание - Произвольный - значение либо развёрнутое описание флага.
//
Процедура УстановитьФлаг(Знач Ключ, Знач Описание) Экспорт

	НаборФлагов.Вставить(Строка(Ключ), Описание);

КонецПроцедуры

// Удаляет флаг.
//
// Параметры:
//   Ключ - Строка - ключ флага.
//
Процедура УдалитьФлаг(Знач Ключ) Экспорт

	НаборФлагов.Удалить(Строка(Ключ));

КонецПроцедуры

// Возвращаемое значение:
//   Соответствие - копия текущего набора флагов.
//
Функция Флаги() Экспорт

	Результат = Новый Соответствие();

	Для Каждого Элемент Из НаборФлагов Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция Вычислить_(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст, Знач ОжидаемыйТип)

	Результат = Новый ResolutionDetails(ЗначениеПоУмолчанию);

	Если СостояниеПровайдера = "NOT_READY" Тогда
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ПровайдерНеГотов(),
			"Провайдер не инициализирован", ЗначениеПоУмолчанию);
	КонецЕсли;

	Описание = НаборФлагов.Получить(Строка(Ключ));

	Если Описание = Неопределено Тогда
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ФлагНеНайден(),
			СтрШаблон("Флаг %1 не найден", Ключ), ЗначениеПоУмолчанию);
	КонецЕсли;

	Разрешённое = РазрешитьОписание(Описание, Контекст, ЗначениеПоУмолчанию);

	Если Разрешённое.ЭтоОшибка() Тогда
		Возврат Разрешённое;
	КонецЕсли;

	Если ОжидаемыйТип <> Неопределено И ТипЗнч(Разрешённое.Значение) <> ОжидаемыйТип Тогда
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.НесоответствиеТипа(),
			СтрШаблон("Флаг %1 имеет тип %2, ожидался %3",
				Ключ, Строка(ТипЗнч(Разрешённое.Значение)), Строка(ОжидаемыйТип)),
			ЗначениеПоУмолчанию);
	КонецЕсли;

	Возврат Разрешённое;

КонецФункции

Функция РазрешитьОписание(Знач Описание, Знач Контекст, Знач ЗначениеПоУмолчанию)

	Если Не ЭтоРазвёрнутоеОписание(Описание) Тогда
		Возврат Новый ResolutionDetails(Описание, OpenFeatureReason.Статическое());
	КонецЕсли;

	Варианты = ЗначениеПоля(Описание, "Варианты");
	ВариантПоУмолчанию = Строка(ЗначениеПоля(Описание, "ВариантПоУмолчанию", ""));
	Включен = ЗначениеПоля(Описание, "Включен", Истина);

	Если Включен = Ложь Тогда
		Результат = Новый ResolutionDetails(ЗначениеПоУмолчанию, OpenFeatureReason.Выключено());
		Возврат Результат;
	КонецЕсли;

	Если Варианты = Неопределено Тогда
		Возврат Новый ResolutionDetails(ЗначениеПоля(Описание, "Значение"), OpenFeatureReason.Статическое());
	КонецЕсли;

	ИмяВарианта = ПодобратьВариантПоПравилам(Описание, Контекст);
	Причина = ?(ПустаяСтрока(ИмяВарианта), OpenFeatureReason.Статическое(), OpenFeatureReason.СовпадениеТаргетинга());

	Если ПустаяСтрока(ИмяВарианта) Тогда
		ИмяВарианта = ВариантПоУмолчанию;
	КонецЕсли;

	Если ПустаяСтрока(ИмяВарианта) Тогда
		Результат = Новый ResolutionDetails(ЗначениеПоУмолчанию);
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ОшибкаРазбора(),
			"Не задан вариант по умолчанию", ЗначениеПоУмолчанию);
	КонецЕсли;

	ЗначениеВарианта = ЗначениеПоля(Варианты, ИмяВарианта);

	Если ЗначениеВарианта = Неопределено Тогда
		Результат = Новый ResolutionDetails(ЗначениеПоУмолчанию);
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ОшибкаРазбора(),
			СтрШаблон("Вариант %1 не описан", ИмяВарианта), ЗначениеПоУмолчанию);
	КонецЕсли;

	Возврат Новый ResolutionDetails(ЗначениеВарианта, Причина, ИмяВарианта);

КонецФункции

// Правило срабатывает, когда значение атрибута контекста входит в список
// перечисленных значений. Проверяются по порядку, побеждает первое совпавшее.
//
Функция ПодобратьВариантПоПравилам(Знач Описание, Знач Контекст)

	Правила = ЗначениеПоля(Описание, "Правила");

	Если Правила = Неопределено Или Контекст = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Правило Из Правила Цикл

		ИмяАтрибута = Строка(ЗначениеПоля(Правило, "Атрибут", ""));
		ЗначениеАтрибута = Контекст.Получить(ИмяАтрибута);

		Если ЗначениеАтрибута = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ДопустимоеЗначение Из ЗначениеПоля(Правило, "Значения", Новый Массив()) Цикл
			Если Строка(ДопустимоеЗначение) = Строка(ЗначениеАтрибута) Тогда
				Возврат Строка(ЗначениеПоля(Правило, "Вариант", ""));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЭтоРазвёрнутоеОписание(Знач Описание)

	ТипОписания = ТипЗнч(Описание);

	Если ТипОписания <> Тип("Структура") И ТипОписания <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеПоля(Описание, "Варианты") <> Неопределено
		Или ЗначениеПоля(Описание, "Значение") <> Неопределено
		Или ЗначениеПоля(Описание, "Включен") <> Неопределено;

КонецФункции

Функция ЗначениеПоля(Знач Источник, Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено)

	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Найденное = Источник.Получить(Имя);
		Возврат ?(Найденное = Неопределено, ЗначениеПоУмолчанию, Найденное);
	КонецЕсли;

	Найденное = Неопределено;

	Если Источник.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

