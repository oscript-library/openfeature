// Клиент оценки флагов.
// Спецификация: https://openfeature.dev/specification/sections/flag-evaluation
//
// Методы оценки не выбрасывают исключений: любая внештатная ситуация -
// недоступный провайдер, отсутствующий флаг, неверный тип - приводит
// к возврату значения по умолчанию.

Перем Реестр;
Перем ИмяДомена;
Перем ХукиКлиента;

// Параметры:
//   РеестрAPI - Произвольный - объект, дающий доступ к провайдеру, глобальным
//                              хукам и глобальному контексту.
//   Домен     - Строка - имя домена, к которому привязан клиент.
//
Процедура ПриСозданииОбъекта(Знач РеестрAPI, Знач Домен = "")

	Реестр = РеестрAPI;
	ИмяДомена = Домен;
	ХукиКлиента = Новый Массив();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Метаданные и настройка

// Возвращаемое значение:
//   Структура - метаданные клиента с полем Домен.
//
Функция Метаданные() Экспорт

	Возврат Новый Структура("Домен", ИмяДомена);

КонецФункции

// Добавляет хук, выполняемый при каждой оценке этого клиента.
//
// Параметры:
//   Хук - Произвольный - объект с методами До, После, ПриОшибке, Финально
//                        (любой из них может отсутствовать).
//
Процедура ДобавитьХук(Знач Хук) Экспорт

	ХукиКлиента.Добавить(Хук);

КонецПроцедуры

// Возвращаемое значение:
//   Строка - состояние связанного провайдера.
//
Функция СостояниеПровайдера() Экспорт

	Возврат Реестр.СостояниеПровайдера();

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Оценка значений

// Параметры:
//   Ключ                - Строка - ключ флага.
//   ЗначениеПоУмолчанию - Булево - значение при любой внештатной ситуации.
//   Контекст            - EvaluationContext - контекст вызова.
//   Параметры           - Структура - дополнительные хуки и подсказки, см. Оценить.
//
// Возвращаемое значение:
//   Булево - значение флага.
//
Функция ПолучитьЛогическое(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат ПолучитьЛогическоеСДеталями(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры).Значение;

КонецФункции

Функция ПолучитьСтроку(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат ПолучитьСтрокуСДеталями(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры).Значение;

КонецФункции

Функция ПолучитьЧисло(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат ПолучитьЧислоСДеталями(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры).Значение;

КонецФункции

Функция ПолучитьОбъект(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат ПолучитьОбъектСДеталями(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры).Значение;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Оценка с деталями

// Параметры:
//   Ключ                - Строка - ключ флага.
//   ЗначениеПоУмолчанию - Булево - значение при любой внештатной ситуации.
//   Контекст            - EvaluationContext - контекст вызова.
//   Параметры           - Структура - дополнительные хуки и подсказки, см. Оценить.
//
// Возвращаемое значение:
//   EvaluationDetails - значение вместе с вариантом, причиной и кодом ошибки.
//
Функция ПолучитьЛогическоеСДеталями(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат Оценить(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры, "ВычислитьЛогическое", Тип("Булево"));

КонецФункции

Функция ПолучитьСтрокуСДеталями(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат Оценить(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры, "ВычислитьСтроку", Тип("Строка"));

КонецФункции

Функция ПолучитьЧислоСДеталями(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат Оценить(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры, "ВычислитьЧисло", Тип("Число"));

КонецФункции

Функция ПолучитьОбъектСДеталями(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст = Неопределено,
	Знач Параметры = Неопределено) Экспорт

	Возврат Оценить(Ключ, ЗначениеПоУмолчанию, Контекст, Параметры, "ВычислитьОбъект", Неопределено);

КонецФункции

////////////////////////////////////////////////////////////////////////////////

// Полный жизненный цикл оценки: хуки До, разрешение флага провайдером,
// хуки После либо ПриОшибке, затем Финально.
//
Функция Оценить(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст, Знач Параметры,
	Знач ИмяМетодаПровайдера, Знач ОжидаемыйТип)

	Детали = Новый EvaluationDetails(Ключ, ЗначениеПоУмолчанию);
	Хуки = СобратьХуки(Параметры);
	Подсказки = ЗначениеПоля(Параметры, "ПодсказкиХуков", Новый Соответствие());

	ИтоговыйКонтекст = Реестр.ГлобальныйКонтекст().Объединить(Контекст);
	ДанныеХука = СоздатьДанныеХука(Ключ, ЗначениеПоУмолчанию, ИтоговыйКонтекст, ИмяМетодаПровайдера);

	Попытка

		ИтоговыйКонтекст = ВыполнитьХукиДо(Хуки, ДанныеХука, Подсказки, ИтоговыйКонтекст);
		ДанныеХука.Вставить("Контекст", ИтоговыйКонтекст);

		Результат = РазрешитьФлаг(ИмяМетодаПровайдера, Ключ, ЗначениеПоУмолчанию, ИтоговыйКонтекст);
		Результат = ПроверитьТип(Результат, ОжидаемыйТип, Ключ, ЗначениеПоУмолчанию);

		Детали.ЗаполнитьИзРезультата(Результат);

		Если Детали.ЭтоОшибка() Тогда
			ВыполнитьХукиПриОшибке(Хуки, ДанныеХука, Детали.СообщениеОбОшибке, Подсказки);
		Иначе
			ВыполнитьХукиПосле(Хуки, ДанныеХука, Детали, Подсказки);
		КонецЕсли;

	Исключение

		// Спецификация запрещает клиенту выбрасывать исключения: неожиданный сбой
		// провайдера или хука превращается в обычный отказ со значением по умолчанию
		Сбой = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

		Детали = Новый EvaluationDetails(Ключ, ЗначениеПоУмолчанию);
		Детали.КодОшибки = OpenFeatureErrorCode.Общая();
		Детали.СообщениеОбОшибке = Сбой;
		Детали.Причина = OpenFeatureReason.Ошибка();

		ВыполнитьХукиПриОшибке(Хуки, ДанныеХука, Сбой, Подсказки);

	КонецПопытки;

	ВыполнитьХукиФинально(Хуки, ДанныеХука, Детали, Подсказки);

	Возврат Детали;

КонецФункции

Функция РазрешитьФлаг(Знач ИмяМетодаПровайдера, Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст)

	Провайдер = Реестр.Провайдер();

	Если ИмяМетодаПровайдера = "ВычислитьЛогическое" Тогда
		Возврат Провайдер.ВычислитьЛогическое(Ключ, ЗначениеПоУмолчанию, Контекст);
	ИначеЕсли ИмяМетодаПровайдера = "ВычислитьСтроку" Тогда
		Возврат Провайдер.ВычислитьСтроку(Ключ, ЗначениеПоУмолчанию, Контекст);
	ИначеЕсли ИмяМетодаПровайдера = "ВычислитьЧисло" Тогда
		Возврат Провайдер.ВычислитьЧисло(Ключ, ЗначениеПоУмолчанию, Контекст);
	КонецЕсли;

	Возврат Провайдер.ВычислитьОбъект(Ключ, ЗначениеПоУмолчанию, Контекст);

КонецФункции

// Провайдер может вернуть значение неожиданного типа - например если в JSON
// строку записали вместо числа. Спецификация требует в этом случае отдать
// значение по умолчанию, а не приводить типы молча.
//
Функция ПроверитьТип(Знач Результат, Знач ОжидаемыйТип, Знач Ключ, Знач ЗначениеПоУмолчанию)

	Если Результат = Неопределено Тогда
		Отказ = Новый ResolutionDetails(ЗначениеПоУмолчанию);
		Возврат Отказ.ЗаполнитьОшибку(OpenFeatureErrorCode.Общая(),
			"Провайдер не вернул результат", ЗначениеПоУмолчанию);
	КонецЕсли;

	Если Результат.ЭтоОшибка() Или ОжидаемыйТип = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Результат.Значение) = ОжидаемыйТип Тогда
		Возврат Результат;
	КонецЕсли;

	Отказ = Новый ResolutionDetails(ЗначениеПоУмолчанию);

	Возврат Отказ.ЗаполнитьОшибку(OpenFeatureErrorCode.НесоответствиеТипа(),
		СтрШаблон("Флаг %1 вернул тип %2, ожидался %3",
			Ключ, Строка(ТипЗнч(Результат.Значение)), Строка(ОжидаемыйТип)),
		ЗначениеПоУмолчанию);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Хуки

// Порядок из спецификации: хуки До выполняются от глобальных к локальным,
// а После, ПриОшибке и Финально - в обратном порядке.
//
Функция СобратьХуки(Знач Параметры)

	Результат = Новый Массив();

	Для Каждого Хук Из Реестр.ГлобальныеХуки() Цикл
		Результат.Добавить(Хук);
	КонецЦикла;

	Для Каждого Хук Из ХукиКлиента Цикл
		Результат.Добавить(Хук);
	КонецЦикла;

	Для Каждого Хук Из ЗначениеПоля(Параметры, "Хуки", Новый Массив()) Цикл
		Результат.Добавить(Хук);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыполнитьХукиДо(Знач Хуки, Знач ДанныеХука, Знач Подсказки, Знач Контекст)

	Результат = Контекст;

	Для Каждого Хук Из Хуки Цикл

		Если Не ЕстьСтадия(Хук, "До") Тогда
			Продолжить;
		КонецЕсли;

		Возвращённое = Хук.До(ДанныеХука, Подсказки);

		// Хук может дополнить контекст - возвращённые атрибуты имеют приоритет
		Если Возвращённое <> Неопределено Тогда
			Результат = Результат.Объединить(Возвращённое);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВыполнитьХукиПосле(Знач Хуки, Знач ДанныеХука, Знач Детали, Знач Подсказки)

	Индекс = Хуки.Количество() - 1;

	Пока Индекс >= 0 Цикл

		Если ЕстьСтадия(Хуки[Индекс], "После") Тогда
			Попытка
				Хуки[Индекс].После(ДанныеХука, Детали, Подсказки);
			Исключение
				// Сбой хука не отменяет уже полученное значение флага
			КонецПопытки;
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

КонецПроцедуры

Процедура ВыполнитьХукиПриОшибке(Знач Хуки, Знач ДанныеХука, Знач Ошибка, Знач Подсказки)

	Индекс = Хуки.Количество() - 1;

	Пока Индекс >= 0 Цикл

		Если ЕстьСтадия(Хуки[Индекс], "ПриОшибке") Тогда
			Попытка
				Хуки[Индекс].ПриОшибке(ДанныеХука, Ошибка, Подсказки);
			Исключение
				// Сбой хука не должен подменять исходную причину отказа
			КонецПопытки;
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

КонецПроцедуры

Процедура ВыполнитьХукиФинально(Знач Хуки, Знач ДанныеХука, Знач Детали, Знач Подсказки)

	Индекс = Хуки.Количество() - 1;

	Пока Индекс >= 0 Цикл

		Если ЕстьСтадия(Хуки[Индекс], "Финально") Тогда
			Попытка
				Хуки[Индекс].Финально(ДанныеХука, Детали, Подсказки);
			Исключение
				// Финальная стадия не может повлиять на результат
			КонецПопытки;
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

КонецПроцедуры

Функция СоздатьДанныеХука(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст, Знач ИмяМетодаПровайдера)

	Результат = Новый Структура();
	Результат.Вставить("КлючФлага", Ключ);
	Результат.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Результат.Вставить("ТипФлага", ТипФлагаПоМетоду(ИмяМетодаПровайдера));
	Результат.Вставить("Контекст", Контекст);
	Результат.Вставить("МетаданныеКлиента", Метаданные());
	Результат.Вставить("МетаданныеПровайдера", Реестр.МетаданныеПровайдера());

	Возврат Результат;

КонецФункции

Функция ТипФлагаПоМетоду(Знач ИмяМетодаПровайдера)

	Если ИмяМетодаПровайдера = "ВычислитьЛогическое" Тогда
		Возврат "Булево";
	ИначеЕсли ИмяМетодаПровайдера = "ВычислитьСтроку" Тогда
		Возврат "Строка";
	ИначеЕсли ИмяМетодаПровайдера = "ВычислитьЧисло" Тогда
		Возврат "Число";
	КонецЕсли;

	Возврат "Объект";

КонецФункции

////////////////////////////////////////////////////////////////////////////////

// Хук вправе реализовать не все стадии: отсутствие метода - не ошибка.
//
Функция ЕстьСтадия(Знач Хук, Знач ИмяСтадии)

	Если Хук = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Реестр.ЕстьМетод(Хук, ИмяСтадии);

КонецФункции

Функция ЗначениеПоля(Знач Источник, Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено)

	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Найденное = Источник.Получить(Имя);
		Возврат ?(Найденное = Неопределено, ЗначениеПоУмолчанию, Найденное);
	КонецЕсли;

	Найденное = Неопределено;

	Если Источник.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции
