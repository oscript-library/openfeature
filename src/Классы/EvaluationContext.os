// Данные, по которым провайдер принимает решение об оценке флага.
// Спецификация: https://openfeature.dev/specification/sections/evaluation-context
//
// Ключ таргетинга (targetingKey) - идентификатор субъекта оценки: по нему
// провайдеры закрепляют пользователя за вариантом.

Перем Атрибуты;

// Параметры:
//   КлючТаргетинга - Строка - идентификатор субъекта оценки, например
//                             пользователя или организации.
//   НачальныеАтрибуты - Структура, Соответствие - произвольные атрибуты.
//
Процедура ПриСозданииОбъекта(Знач КлючТаргетинга = "", Знач НачальныеАтрибуты = Неопределено)

	Атрибуты = Новый Соответствие();

	Если НачальныеАтрибуты <> Неопределено Тогда
		Для Каждого Элемент Из НачальныеАтрибуты Цикл
			Атрибуты.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(КлючТаргетинга) Тогда
		Атрибуты.Вставить("targetingKey", КлючТаргетинга);
	КонецЕсли;

КонецПроцедуры

// Ключ таргетинга.
//
// Возвращаемое значение:
//   Строка - значение targetingKey либо пустая строка.
//
Функция КлючТаргетинга() Экспорт

	Значение = Атрибуты.Получить("targetingKey");

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// Устанавливает ключ таргетинга.
//
// Параметры:
//   Значение - Строка - новый ключ таргетинга.
//
// Возвращаемое значение:
//   EvaluationContext - этот же контекст, для цепочки вызовов.
//
Функция УстановитьКлючТаргетинга(Знач Значение) Экспорт

	Атрибуты.Вставить("targetingKey", Строка(Значение));

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет атрибут.
//
// Параметры:
//   Имя      - Строка - имя атрибута.
//   Значение - Произвольный - значение атрибута.
//
// Возвращаемое значение:
//   EvaluationContext - этот же контекст, для цепочки вызовов.
//
Функция Установить(Знач Имя, Знач Значение) Экспорт

	Атрибуты.Вставить(Строка(Имя), Значение);

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает значение атрибута.
//
// Параметры:
//   Имя                 - Строка - имя атрибута.
//   ЗначениеПоУмолчанию - Произвольный - результат, если атрибута нет.
//
// Возвращаемое значение:
//   Произвольный - значение атрибута.
//
Функция Получить(Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	Значение = Атрибуты.Получить(Строка(Имя));

	Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);

КонецФункции

// Параметры:
//   Имя - Строка - имя атрибута.
//
// Возвращаемое значение:
//   Булево - Истина, если атрибут задан.
//
Функция Содержит(Знач Имя) Экспорт

	Возврат Атрибуты.Получить(Строка(Имя)) <> Неопределено;

КонецФункции

// Все атрибуты, включая targetingKey.
//
// Возвращаемое значение:
//   Соответствие - копия атрибутов.
//
Функция Атрибуты() Экспорт

	Результат = Новый Соответствие();

	Для Каждого Элемент Из Атрибуты Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объединяет контекст с другим. Значения другого контекста имеют приоритет -
// так спецификация предписывает разрешать конфликты.
//
// Параметры:
//   Другой - EvaluationContext - контекст с более высоким приоритетом.
//
// Возвращаемое значение:
//   EvaluationContext - новый контекст, исходные не изменяются.
//
Функция Объединить(Знач Другой) Экспорт

	Результат = Новый EvaluationContext();

	Для Каждого Элемент Из Атрибуты Цикл
		Результат.Установить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Если Другой <> Неопределено Тогда
		Для Каждого Элемент Из Другой.Атрибуты() Цикл
			Результат.Установить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//   Число - количество атрибутов.
//
Функция Количество() Экспорт

	Возврат Атрибуты.Количество();

КонецФункции
