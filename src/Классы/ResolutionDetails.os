// Результат разрешения флага провайдером (resolution details).
//
// Спецификация: https://openfeature.dev/specification/types#resolution-details
//
// Структуру заполняет автор провайдера; прикладному коду она не видна -
// клиент преобразует её в EvaluationDetails.

// Произвольный. Значение флага.
Перем Значение Экспорт;

// Строка. Идентификатор варианта, если провайдер его различает.
Перем Вариант Экспорт;

// Строка. Причина, по которой получено значение, см. модуль OpenFeatureReason.
Перем Причина Экспорт;

// Строка. Код ошибки, см. модуль OpenFeatureErrorCode. Пустая строка при успехе.
Перем КодОшибки Экспорт;

// Строка. Пояснение к ошибке.
Перем СообщениеОбОшибке Экспорт;

// Соответствие. Произвольные метаданные флага.
Перем МетаданныеФлага Экспорт;

// Параметры:
//   ЗначениеФлага - Произвольный - результат разрешения.
//   ПричинаОценки - Строка - причина, см. модуль OpenFeatureReason.
//   ВариантФлага  - Строка - идентификатор варианта.
//
Процедура ПриСозданииОбъекта(Знач ЗначениеФлага = Неопределено, Знач ПричинаОценки = "STATIC",
	Знач ВариантФлага = "")

	Значение = ЗначениеФлага;
	Причина = ПричинаОценки;
	Вариант = ВариантФлага;
	КодОшибки = "";
	СообщениеОбОшибке = "";
	МетаданныеФлага = Новый Соответствие();

КонецПроцедуры

// Помечает результат как ошибочный.
//
// Параметры:
//   Код       - Строка - код ошибки, см. модуль OpenFeatureErrorCode.
//   Сообщение - Строка - пояснение.
//   ЗначениеПоУмолчанию - Произвольный - значение, которое получит вызывающий.
//
// Возвращаемое значение:
//   ResolutionDetails - этот же результат, для цепочки вызовов.
//
Функция ЗаполнитьОшибку(Знач Код, Знач Сообщение, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	КодОшибки = Код;
	СообщениеОбОшибке = Сообщение;
	Причина = "ERROR";
	Вариант = "";
	Значение = ЗначениеПоУмолчанию;

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет метаданные флага.
//
// Параметры:
//   Имя      - Строка - имя метаданного.
//   Значение - Строка, Число, Булево - значение метаданного.
//
// Возвращаемое значение:
//   ResolutionDetails - этот же результат, для цепочки вызовов.
//
Функция УстановитьМетаданное(Знач Имя, Знач ЗначениеМетаданного) Экспорт

	МетаданныеФлага.Вставить(Строка(Имя), ЗначениеМетаданного);

	Возврат ЭтотОбъект;

КонецФункции

// Возвращаемое значение:
//   Булево - Истина, если разрешение завершилось ошибкой.
//
Функция ЭтоОшибка() Экспорт

	Возврат Не ПустаяСтрока(КодОшибки);

КонецФункции
