// Изолированный экземпляр OpenFeature API.
// Спецификация: https://openfeature.dev/specification/sections/flag-evaluation
//
// Хранит провайдера, глобальные хуки и глобальный контекст оценки.
// Модуль OpenFeature - глобальный экземпляр реестра.

#Использовать reflector

Перем ТекущийПровайдер;
Перем ГлобальныеХукиAPI;
Перем ГлобальныйКонтекстОценки;
Перем ИсследовательТипов;
Перем КэшМетодов;

Процедура ПриСозданииОбъекта()

	ГлобальныеХукиAPI = Новый Массив();
	ГлобальныйКонтекстОценки = Новый EvaluationContext();
	ИсследовательТипов = Новый Рефлектор();
	КэшМетодов = Новый Соответствие();

	ТекущийПровайдер = Новый NoopProvider();
	ТекущийПровайдер.Инициализировать(ГлобальныйКонтекстОценки);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Провайдер

// Регистрирует провайдера: инициализирует нового и завершает предыдущего.
//
// Параметры:
//   Провайдер - Произвольный - объект, реализующий контракт провайдера.
//
Процедура УстановитьПровайдер(Знач Провайдер) Экспорт

	Если Провайдер = Неопределено Тогда
		ВызватьИсключение "OpenFeature: провайдер не задан";
	КонецЕсли;

	Предыдущий = ТекущийПровайдер;

	Попытка
		Провайдер.Инициализировать(ГлобальныйКонтекстОценки);
	Исключение
		// Провайдер, не сумевший подняться, сообщит об этом своим состоянием;
		// падать на старте приложения из-за флагов нельзя
	КонецПопытки;

	ТекущийПровайдер = Провайдер;

	Если Предыдущий <> Неопределено И Предыдущий <> Провайдер Тогда
		Попытка
			Предыдущий.Завершить();
		Исключение
			// Освобождение ресурсов прежнего провайдера не влияет на новый
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//   Произвольный - текущий провайдер.
//
Функция Провайдер() Экспорт

	Возврат ТекущийПровайдер;

КонецФункции

// Возвращаемое значение:
//   Структура - метаданные текущего провайдера.
//
Функция МетаданныеПровайдера() Экспорт

	Попытка
		Возврат ТекущийПровайдер.Метаданные();
	Исключение
		Возврат Новый Структура("Имя", "Неизвестный");
	КонецПопытки;

КонецФункции

// Возвращаемое значение:
//   Строка - состояние провайдера: NOT_READY, READY, ERROR, STALE или FATAL.
//
Функция СостояниеПровайдера() Экспорт

	Попытка
		Возврат ТекущийПровайдер.Состояние();
	Исключение
		Возврат "ERROR";
	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Клиенты, хуки и контекст

// Создаёт клиента. Функция не выбрасывает исключений даже без провайдера.
//
// Параметры:
//   Домен - Строка - имя домена, попадает в метаданные клиента.
//
// Возвращаемое значение:
//   FeatureClient - новый клиент.
//
Функция ПолучитьКлиента(Знач Домен = "") Экспорт

	Возврат Новый FeatureClient(ЭтотОбъект, Домен);

КонецФункции

// Добавляет хук, выполняемый при каждой оценке любого клиента.
//
// Параметры:
//   Хук - Произвольный - объект с методами До, После, ПриОшибке, Финально.
//
Процедура ДобавитьХук(Знач Хук) Экспорт

	ГлобальныеХукиAPI.Добавить(Хук);

КонецПроцедуры

// Возвращаемое значение:
//   Массив - зарегистрированные глобальные хуки.
//
Функция ГлобальныеХуки() Экспорт

	Возврат ГлобальныеХукиAPI;

КонецФункции

// Устанавливает глобальный контекст оценки. Он объединяется с контекстом
// вызова, причём контекст вызова имеет приоритет.
//
// Параметры:
//   Контекст - EvaluationContext - контекст уровня приложения.
//
Процедура УстановитьГлобальныйКонтекст(Знач Контекст) Экспорт

	ГлобальныйКонтекстОценки = ?(Контекст = Неопределено, Новый EvaluationContext(), Контекст);

КонецПроцедуры

// Возвращаемое значение:
//   EvaluationContext - глобальный контекст оценки.
//
Функция ГлобальныйКонтекст() Экспорт

	Возврат ГлобальныйКонтекстОценки;

КонецФункции

// Завершает провайдера и сбрасывает всё состояние: хуки, контекст и провайдера.
//
Процедура Завершить() Экспорт

	Попытка
		ТекущийПровайдер.Завершить();
	Исключение
		// Провайдер мог уже освободить ресурсы
	КонецПопытки;

	ГлобальныеХукиAPI = Новый Массив();
	ГлобальныйКонтекстОценки = Новый EvaluationContext();
	КэшМетодов = Новый Соответствие();

	ТекущийПровайдер = Новый NoopProvider();
	ТекущийПровайдер.Инициализировать(ГлобальныйКонтекстОценки);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

// Проверяет наличие метода у объекта. Результат кэшируется по типу:
// разбор состава методов дороже самой оценки флага.
//
// Параметры:
//   Объект    - Произвольный - проверяемый объект.
//   ИмяМетода - Строка - имя искомого метода.
//
// Возвращаемое значение:
//   Булево - Истина, если метод есть.
//
Функция ЕстьМетод(Знач Объект, Знач ИмяМетода) Экспорт

	КлючКэша = Строка(ТипЗнч(Объект)) + "." + ИмяМетода;
	Известное = КэшМетодов.Получить(КлючКэша);

	Если Известное <> Неопределено Тогда
		Возврат Известное;
	КонецЕсли;

	Попытка
		Результат = ИсследовательТипов.ПолучитьТаблицуМетодов(Объект).Найти(ИмяМетода, "Имя") <> Неопределено;
	Исключение
		// Если состав методов недоступен, безопаснее попытаться вызвать
		Результат = Истина;
	КонецПопытки;

	КэшМетодов.Вставить(КлючКэша, Результат);

	Возврат Результат;

КонецФункции

