// Провайдер флагов, читающий конфигурацию из JSON-файла.
//
// Формат файла - тот же, что понимает InMemoryProvider. Файл перечитывается
// при инициализации и по явному вызову Перечитать.

Перем ПутьКФайлу;
Перем Провайдер;
Перем СостояниеПровайдера;
Перем ОписаниеОшибкиЧтения;

// Параметры:
//   Путь - Строка - путь к JSON-файлу с описанием флагов.
//
Процедура ПриСозданииОбъекта(Знач Путь)

	Если ТипЗнч(Путь) <> Тип("Строка") Или ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "OpenFeature: не задан путь к файлу флагов";
	КонецЕсли;

	ПутьКФайлу = Путь;
	Провайдер = Новый InMemoryProvider();
	СостояниеПровайдера = "NOT_READY";
	ОписаниеОшибкиЧтения = "";

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Контракт провайдера

Функция Метаданные() Экспорт

	Возврат Новый Структура("Имя", "JsonFileProvider");

КонецФункции

Процедура Инициализировать(Знач Контекст = Неопределено) Экспорт

	Провайдер.Инициализировать(Контекст);
	Перечитать();

КонецПроцедуры

Процедура Завершить() Экспорт

	Провайдер.Завершить();
	СостояниеПровайдера = "NOT_READY";

КонецПроцедуры

Функция Состояние() Экспорт

	Возврат СостояниеПровайдера;

КонецФункции

Функция ВычислитьЛогическое(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Отказ = ПроверитьГотовность(ЗначениеПоУмолчанию);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Возврат Провайдер.ВычислитьЛогическое(Ключ, ЗначениеПоУмолчанию, Контекст);

КонецФункции

Функция ВычислитьСтроку(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Отказ = ПроверитьГотовность(ЗначениеПоУмолчанию);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Возврат Провайдер.ВычислитьСтроку(Ключ, ЗначениеПоУмолчанию, Контекст);

КонецФункции

Функция ВычислитьЧисло(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Отказ = ПроверитьГотовность(ЗначениеПоУмолчанию);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Возврат Провайдер.ВычислитьЧисло(Ключ, ЗначениеПоУмолчанию, Контекст);

КонецФункции

Функция ВычислитьОбъект(Знач Ключ, Знач ЗначениеПоУмолчанию, Знач Контекст) Экспорт

	Отказ = ПроверитьГотовность(ЗначениеПоУмолчанию);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Возврат Провайдер.ВычислитьОбъект(Ключ, ЗначениеПоУмолчанию, Контекст);

КонецФункции

////////////////////////////////////////////////////////////////////////////////

// Перечитывает файл. Ошибка чтения переводит провайдера в состояние ERROR
// и не поднимается наверх: оценка продолжается на значениях по умолчанию.
//
// Возвращаемое значение:
//   Булево - Истина, если файл прочитан успешно.
//
Функция Перечитать() Экспорт

	Файл = Новый Файл(ПутьКФайлу);

	Если Не Файл.Существует() Тогда
		СостояниеПровайдера = "ERROR";
		ОписаниеОшибкиЧтения = СтрШаблон("Файл флагов %1 не найден", ПутьКФайлу);
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Содержимое = ПрочитатьСодержимое();
	Исключение
		СостояниеПровайдера = "ERROR";
		ОписаниеОшибкиЧтения = СтрШаблон("Не удалось прочитать %1: %2", ПутьКФайлу, ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Если ТипЗнч(Содержимое) <> Тип("Соответствие") Тогда
		СостояниеПровайдера = "ERROR";
		ОписаниеОшибкиЧтения = СтрШаблон("Файл %1 должен содержать объект JSON", ПутьКФайлу);
		Возврат Ложь;
	КонецЕсли;

	Провайдер.ЗаменитьФлаги(Содержимое);
	СостояниеПровайдера = "READY";
	ОписаниеОшибкиЧтения = "";

	Возврат Истина;

КонецФункции

// Возвращаемое значение:
//   Строка - описание последней ошибки чтения файла.
//
Функция ПоследняяОшибка() Экспорт

	Возврат ОписаниеОшибкиЧтения;

КонецФункции

// Возвращаемое значение:
//   Соответствие - текущий набор флагов.
//
Функция Флаги() Экспорт

	Возврат Провайдер.Флаги();

КонецФункции

Функция ПрочитатьСодержимое()

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ПутьКФайлу);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция ПроверитьГотовность(Знач ЗначениеПоУмолчанию)

	Если СостояниеПровайдера = "READY" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый ResolutionDetails(ЗначениеПоУмолчанию);

	Если СостояниеПровайдера = "ERROR" Тогда
		Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ОшибкаРазбора(),
			ОписаниеОшибкиЧтения, ЗначениеПоУмолчанию);
	КонецЕсли;

	Возврат Результат.ЗаполнитьОшибку(OpenFeatureErrorCode.ПровайдерНеГотов(),
		"Провайдер не инициализирован", ЗначениеПоУмолчанию);

КонецФункции
