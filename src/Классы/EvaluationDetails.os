// Подробный результат оценки флага (evaluation details).
// Спецификация: https://openfeature.dev/specification/types#evaluation-details
//
// Возвращается методами вида ПолучитьЛогическоеСДеталями. Всегда содержит
// значение: при ошибке это значение по умолчанию, а причина отказа описана
// полями КодОшибки и СообщениеОбОшибке.

// Строка. Ключ оцененного флага.
Перем КлючФлага Экспорт;

// Произвольный. Значение флага либо значение по умолчанию при ошибке.
Перем Значение Экспорт;

// Строка. Идентификатор варианта, если провайдер его различает.
Перем Вариант Экспорт;

// Строка. Причина, по которой получено значение, см. модуль OpenFeatureReason.
Перем Причина Экспорт;

// Строка. Код ошибки, см. модуль OpenFeatureErrorCode. Пустая строка при успехе.
Перем КодОшибки Экспорт;

// Строка. Пояснение к ошибке.
Перем СообщениеОбОшибке Экспорт;

// Соответствие. Метаданные флага, переданные провайдером.
Перем МетаданныеФлага Экспорт;

Процедура ПриСозданииОбъекта(Знач Ключ = "", Знач ЗначениеФлага = Неопределено)

	КлючФлага = Ключ;
	Значение = ЗначениеФлага;
	Вариант = "";
	Причина = "";
	КодОшибки = "";
	СообщениеОбОшибке = "";
	МетаданныеФлага = Новый Соответствие();

КонецПроцедуры

// Заполняет детали из результата провайдера.
//
// Параметры:
//   Результат - ResolutionDetails - результат разрешения флага.
//
Процедура ЗаполнитьИзРезультата(Знач Результат) Экспорт

	Значение = Результат.Значение;
	Вариант = Результат.Вариант;
	Причина = Результат.Причина;
	КодОшибки = Результат.КодОшибки;
	СообщениеОбОшибке = Результат.СообщениеОбОшибке;

	// Спецификация требует пустую запись, а не отсутствующее значение,
	// когда провайдер метаданных не передал
	МетаданныеФлага = ?(Результат.МетаданныеФлага = Неопределено, Новый Соответствие(), Результат.МетаданныеФлага);

КонецПроцедуры

// Возвращаемое значение:
//   Булево - Истина, если оценка завершилась ошибкой.
//
Функция ЭтоОшибка() Экспорт

	Возврат Не ПустаяСтрока(КодОшибки);

КонецФункции

// Значение метаданного флага.
//
// Параметры:
//   Имя                 - Строка - имя метаданного.
//   ЗначениеПоУмолчанию - Произвольный - результат, если метаданного нет.
//
// Возвращаемое значение:
//   Произвольный - значение метаданного.
//
Функция Метаданное(Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	Найденное = МетаданныеФлага.Получить(Строка(Имя));

	Возврат ?(Найденное = Неопределено, ЗначениеПоУмолчанию, Найденное);

КонецФункции
