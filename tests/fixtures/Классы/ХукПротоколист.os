// Хук, записывающий порядок вызова стадий - для проверки жизненного цикла.

Перем Метка;
Перем Протокол Экспорт;
Перем ДополнительныйАтрибут;
Перем ПадатьНаСтадииДо;

Процедура ПриСозданииОбъекта(Знач МеткаХука, Знач ОбщийПротокол, Знач Атрибут = Неопределено)

	Метка = МеткаХука;
	Протокол = ОбщийПротокол;
	ДополнительныйАтрибут = Атрибут;
	ПадатьНаСтадииДо = Ложь;

КонецПроцедуры

// Заставляет стадию До выбросить исключение.
//
Процедура ПадатьВДо() Экспорт

	ПадатьНаСтадииДо = Истина;

КонецПроцедуры

Функция До(Знач Данные, Знач Подсказки) Экспорт

	Протокол.Добавить(Метка + ":До");

	Если ПадатьНаСтадииДо Тогда
		ВызватьИсключение "Сбой в хуке";
	КонецЕсли;

	Если ДополнительныйАтрибут = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый EvaluationContext("", ДополнительныйАтрибут);

КонецФункции

Процедура После(Знач Данные, Знач Детали, Знач Подсказки) Экспорт

	Протокол.Добавить(Метка + ":После");

КонецПроцедуры

Процедура ПриОшибке(Знач Данные, Знач Ошибка, Знач Подсказки) Экспорт

	Протокол.Добавить(Метка + ":ПриОшибке");

КонецПроцедуры

Процедура Финально(Знач Данные, Знач Детали, Знач Подсказки) Экспорт

	Протокол.Добавить(Метка + ":Финально");

КонецПроцедуры
