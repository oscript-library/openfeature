#Использовать asserts
#Использовать "../src"
#Использовать "./fixtures"

////////////////////////////////////////////////////////////////////////////////
// Оценка значений

&ПараметризованныйТест(Имя = "Значение флага возвращается по типу: {Параметры}")
&ИсточникЗначение("логический", Истина)
&ИсточникЗначение("строковый", "значение")
&ИсточникЗначение("числовой", 42)
Процедура ЗначениеФлагаВозвращается(Знач Ключ, Знач Эталон) Экспорт

	Клиент = КлиентСФлагами();

	Если ТипЗнч(Эталон) = Тип("Булево") Тогда
		Ожидаем.Что(Клиент.ПолучитьЛогическое(Ключ, Ложь)).Равно(Эталон);
	ИначеЕсли ТипЗнч(Эталон) = Тип("Строка") Тогда
		Ожидаем.Что(Клиент.ПолучитьСтроку(Ключ, "нет")).Равно(Эталон);
	Иначе
		Ожидаем.Что(Клиент.ПолучитьЧисло(Ключ, 0)).Равно(Эталон);
	КонецЕсли;

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Объектный флаг возвращается целиком")
Процедура ОбъектныйФлагВозвращается() Экспорт

	Значение = КлиентСФлагами().ПолучитьОбъект("объектный", Новый Соответствие());

	Ожидаем.Что(Значение["предел"]).Равно(10);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Детали содержат ключ, причину и вариант")
Процедура ДеталиСодержатКлючПричинуВариант() Экспорт

	Детали = КлиентСФлагами().ПолучитьЛогическоеСДеталями("логический", Ложь);

	Ожидаем.Что(Детали.КлючФлага).Равно("логический");
	Ожидаем.Что(Детали.Значение).ЭтоИстина();
	Ожидаем.Что(Детали.Причина).Равно(OpenFeatureReason.Статическое());
	Ожидаем.Что(Детали.ЭтоОшибка()).ЭтоЛожь();
	Ожидаем.Что(Детали.МетаданныеФлага, "Метаданные обязаны быть пустой записью, а не Неопределено").Не_().ЭтоНеопределено();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Внештатные ситуации

&Тест
&ОтображаемоеИмя("Отсутствующий флаг отдаёт значение по умолчанию с кодом FLAG_NOT_FOUND")
Процедура ОтсутствующийФлагОтдаётЗначениеПоУмолчанию() Экспорт

	Детали = КлиентСФлагами().ПолучитьЛогическоеСДеталями("нет-такого", Истина);

	Ожидаем.Что(Детали.Значение).ЭтоИстина();
	Ожидаем.Что(Детали.КодОшибки).Равно(OpenFeatureErrorCode.ФлагНеНайден());
	Ожидаем.Что(Детали.Причина).Равно(OpenFeatureReason.Ошибка());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Несоответствие типа отдаёт значение по умолчанию с кодом TYPE_MISMATCH")
Процедура НесоответствиеТипаОтдаётЗначениеПоУмолчанию() Экспорт

	Детали = КлиентСФлагами().ПолучитьСтрокуСДеталями("логический", "запасное");

	Ожидаем.Что(Детали.Значение).Равно("запасное");
	Ожидаем.Что(Детали.КодОшибки).Равно(OpenFeatureErrorCode.НесоответствиеТипа());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Сбой провайдера не выбрасывает исключение наружу")
Процедура СбойПровайдераНеВыбрасываетИсключение() Экспорт

	Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
	Экземпляр.УстановитьПровайдер(Новый ПровайдерСоСбоем());

	Детали = Экземпляр.ПолучитьКлиента().ПолучитьЛогическоеСДеталями("любой", Истина);

	Ожидаем.Что(Детали.Значение, "Клиент обязан вернуть значение по умолчанию").ЭтоИстина();
	Ожидаем.Что(Детали.КодОшибки).Равно(OpenFeatureErrorCode.Общая());
	Ожидаем.Что(Детали.Причина).Равно(OpenFeatureReason.Ошибка());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Без провайдера работает заглушка и отдаёт значения по умолчанию")
Процедура БезПровайдераРаботаетЗаглушка() Экспорт

	Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();

	Ожидаем.Что(Экземпляр.МетаданныеПровайдера().Имя).Равно("NoopProvider");
	Ожидаем.Что(Экземпляр.ПолучитьКлиента().ПолучитьЛогическое("что-угодно", Истина)).ЭтоИстина();
	Ожидаем.Что(Экземпляр.ПолучитьКлиента().ПолучитьЛогическоеСДеталями("что-угодно", Истина).Причина).Равно(
		OpenFeatureReason.ПоУмолчанию());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Неинициализированный провайдер отдаёт код PROVIDER_NOT_READY")
Процедура НеинициализированныйПровайдерОтдаётКод() Экспорт

	Провайдер = Новый InMemoryProvider(ОписаниеФлагов());

	Результат = Провайдер.ВычислитьЛогическое("логический", Ложь, Неопределено);

	Ожидаем.Что(Результат.КодОшибки).Равно(OpenFeatureErrorCode.ПровайдерНеГотов());

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Таргетинг и варианты

&Тест
&ОтображаемоеИмя("Правило таргетинга выбирает вариант и помечает причину TARGETING_MATCH")
Процедура ПравилоТаргетингаВыбираетВариант() Экспорт

	Клиент = КлиентСФлагами();

	Обычный = Клиент.ПолучитьСтрокуСДеталями("тема", "нет", Новый EvaluationContext("u1", Новый Структура("plan", "free")));
	Платный = Клиент.ПолучитьСтрокуСДеталями("тема", "нет", Новый EvaluationContext("u2", Новый Структура("plan", "pro")));

	Ожидаем.Что(Обычный.Значение).Равно("light");
	Ожидаем.Что(Обычный.Вариант).Равно("светлая");
	Ожидаем.Что(Платный.Значение).Равно("dark");
	Ожидаем.Что(Платный.Вариант).Равно("тёмная");
	Ожидаем.Что(Платный.Причина).Равно(OpenFeatureReason.СовпадениеТаргетинга());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Выключенный флаг отдаёт значение по умолчанию с причиной DISABLED")
Процедура ВыключенныйФлагОтдаётЗначениеПоУмолчанию() Экспорт

	Детали = КлиентСФлагами().ПолучитьЛогическоеСДеталями("выключенный", Ложь);

	Ожидаем.Что(Детали.Значение).ЭтоЛожь();
	Ожидаем.Что(Детали.Причина).Равно(OpenFeatureReason.Выключено());

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Контекст оценки

&Тест
&ОтображаемоеИмя("Контекст вызова имеет приоритет над глобальным")
Процедура КонтекстВызоваИмеетПриоритет() Экспорт

	Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
	Провайдер = Новый InMemoryProvider(ОписаниеФлагов());
	Экземпляр.УстановитьПровайдер(Провайдер);
	Экземпляр.УстановитьГлобальныйКонтекст(Новый EvaluationContext("глобальный", Новый Структура("plan", "free")));

	Клиент = Экземпляр.ПолучитьКлиента();

	Ожидаем.Что(Клиент.ПолучитьСтроку("тема", "нет")).Равно("light");
	Ожидаем.Что(Клиент.ПолучитьСтроку("тема", "нет", Новый EvaluationContext("u", Новый Структура("plan", "pro")))).Равно("dark");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Объединение контекстов не изменяет исходные")
Процедура ОбъединениеКонтекстовНеИзменяетИсходные() Экспорт

	Первый = Новый EvaluationContext("u1", Новый Структура("plan", "free"));
	Второй = Новый EvaluationContext("u2", Новый Структура("plan", "pro"));

	Объединённый = Первый.Объединить(Второй);

	Ожидаем.Что(Объединённый.КлючТаргетинга()).Равно("u2");
	Ожидаем.Что(Объединённый.Получить("plan")).Равно("pro");
	Ожидаем.Что(Первый.КлючТаргетинга(), "Исходный контекст не должен меняться").Равно("u1");
	Ожидаем.Что(Второй.Получить("plan")).Равно("pro");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Ключ таргетинга доступен как обычный атрибут")
Процедура КлючТаргетингаДоступенКакАтрибут() Экспорт

	Контекст = Новый EvaluationContext("user-42");

	Ожидаем.Что(Контекст.КлючТаргетинга()).Равно("user-42");
	Ожидаем.Что(Контекст.Получить("targetingKey")).Равно("user-42");
	Ожидаем.Что(Контекст.Содержит("targetingKey")).ЭтоИстина();
	Ожидаем.Что(Новый EvaluationContext().КлючТаргетинга()).Равно("");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Хуки

&Тест
&ОтображаемоеИмя("Стадии хука выполняются в порядке До, После, Финально")
Процедура СтадииХукаВыполняютсяПоПорядку() Экспорт

	Протокол = Новый Массив();
	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукПротоколист("хук", Протокол));

	Клиент.ПолучитьЛогическое("логический", Ложь);

	Ожидаем.Что(СтрСоединить(Протокол, ",")).Равно("хук:До,хук:После,хук:Финально");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("При ошибке вызываются стадии ПриОшибке и Финально вместо После")
Процедура ПриОшибкеВызываютсяНужныеСтадии() Экспорт

	Протокол = Новый Массив();
	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукПротоколист("хук", Протокол));

	Клиент.ПолучитьЛогическое("нет-такого", Истина);

	Ожидаем.Что(СтрСоединить(Протокол, ",")).Равно("хук:До,хук:ПриОшибке,хук:Финально");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Глобальные хуки выполняются раньше клиентских, а завершаются позже")
Процедура ПорядокГлобальныхИКлиентскихХуков() Экспорт

	Протокол = Новый Массив();
	Экземпляр = ИзолированныйЭкземпляр();
	Экземпляр.ДобавитьХук(Новый ХукПротоколист("глобальный", Протокол));

	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукПротоколист("клиентский", Протокол));

	Клиент.ПолучитьЛогическое("логический", Ложь);

	Ожидаем.Что(СтрСоединить(Протокол, ",")).Равно(
		"глобальный:До,клиентский:До,клиентский:После,глобальный:После,клиентский:Финально,глобальный:Финально");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Хук из параметров вызова добавляется последним")
Процедура ХукИзПараметровВызова() Экспорт

	Протокол = Новый Массив();
	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукПротоколист("клиентский", Протокол));

	Хуки = Новый Массив();
	Хуки.Добавить(Новый ХукПротоколист("вызов", Протокол));

	Клиент.ПолучитьЛогическое("логический", Ложь, Неопределено, Новый Структура("Хуки", Хуки));

	Ожидаем.Что(Протокол[0]).Равно("клиентский:До");
	Ожидаем.Что(Протокол[1]).Равно("вызов:До");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Хук может дополнить контекст оценки")
Процедура ХукДополняетКонтекст() Экспорт

	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукПротоколист("обогащение", Новый Массив(), Новый Структура("plan", "pro")));

	Ожидаем.Что(Клиент.ПолучитьСтроку("тема", "нет")).Равно("dark");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Сбой хука превращается в штатный отказ оценки")
Процедура СбойХукаНеЛоматОценку() Экспорт

	Протокол = Новый Массив();
	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();

	Хук = Новый ХукПротоколист("падающий", Протокол);
	Хук.ПадатьВДо();
	Клиент.ДобавитьХук(Хук);

	Детали = Клиент.ПолучитьЛогическоеСДеталями("логический", Ложь);

	Ожидаем.Что(Детали.Значение, "Должно вернуться значение по умолчанию").ЭтоЛожь();
	Ожидаем.Что(Детали.КодОшибки).Равно(OpenFeatureErrorCode.Общая());
	Ожидаем.Что(СтрСоединить(Протокол, ",")).Равно("падающий:До,падающий:ПриОшибке,падающий:Финально");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Хук без части стадий не вызывает ошибок")
Процедура ХукБезЧастиСтадий() Экспорт

	Экземпляр = ИзолированныйЭкземпляр();
	Клиент = Экземпляр.ПолучитьКлиента();
	Клиент.ДобавитьХук(Новый ХукТолькоДо());

	Ожидаем.Что(Клиент.ПолучитьЛогическое("логический", Ложь)).ЭтоИстина();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Управление провайдером

&Тест
&ОтображаемоеИмя("Регистрация провайдера инициализирует его и завершает предыдущий")
Процедура РегистрацияПровайдераУправляетЖизненнымЦиклом() Экспорт

	Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();

	Первый = Новый InMemoryProvider(ОписаниеФлагов());
	Второй = Новый InMemoryProvider(ОписаниеФлагов());

	Экземпляр.УстановитьПровайдер(Первый);
	Ожидаем.Что(Первый.Состояние()).Равно("READY");

	Экземпляр.УстановитьПровайдер(Второй);

	Ожидаем.Что(Первый.Состояние(), "Предыдущий провайдер должен быть завершён").Равно("NOT_READY");
	Ожидаем.Что(Второй.Состояние()).Равно("READY");
	Ожидаем.Что(Экземпляр.СостояниеПровайдера()).Равно("READY");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Завершение сбрасывает провайдера, хуки и контекст")
Процедура ЗавершениеСбрасываетСостояние() Экспорт

	Экземпляр = ИзолированныйЭкземпляр();
	Экземпляр.ДобавитьХук(Новый ХукПротоколист("хук", Новый Массив()));
	Экземпляр.УстановитьГлобальныйКонтекст(Новый EvaluationContext("u"));

	Экземпляр.Завершить();

	Ожидаем.Что(Экземпляр.МетаданныеПровайдера().Имя).Равно("NoopProvider");
	Ожидаем.Что(Экземпляр.ГлобальныеХуки().Количество()).Равно(0);
	Ожидаем.Что(Экземпляр.ГлобальныйКонтекст().Количество()).Равно(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Изолированные экземпляры не влияют друг на друга")
Процедура ИзолированныеЭкземплярыНезависимы() Экспорт

	Первый = ИзолированныйЭкземпляр();
	Второй = OpenFeature.СоздатьИзолированныйЭкземпляр();

	Ожидаем.Что(Первый.ПолучитьКлиента().ПолучитьЛогическое("логический", Ложь)).ЭтоИстина();
	Ожидаем.Что(Второй.ПолучитьКлиента().ПолучитьЛогическое("логический", Ложь),
		"Второй экземпляр не знает о флагах первого").ЭтоЛожь();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Метаданные клиента содержат домен")
Процедура МетаданныеКлиентаСодержатДомен() Экспорт

	Ожидаем.Что(ИзолированныйЭкземпляр().ПолучитьКлиента("платежи").Метаданные().Домен).Равно("платежи");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Провайдер из файла

&Тест
&ОтображаемоеИмя("Провайдер читает флаги из файла")
Процедура ПровайдерЧитаетФлагиИзФайла() Экспорт

	Провайдер = Новый JsonFileProvider(ФайлФлагов("флаги.json"));
	Провайдер.Инициализировать();

	Ожидаем.Что(Провайдер.Состояние()).Равно("READY");
	Ожидаем.Что(Провайдер.ВычислитьЛогическое("включено", Ложь, Неопределено).Значение).ЭтоИстина();
	Ожидаем.Что(Провайдер.ВычислитьЧисло("предел", 0, Неопределено).Значение).Равно(7);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Отсутствующий файл переводит провайдера в состояние ERROR без исключения")
Процедура ОтсутствующийФайлНеЛоматПровайдера() Экспорт

	Провайдер = Новый JsonFileProvider("нет-такого-файла.json");
	Провайдер.Инициализировать();

	Ожидаем.Что(Провайдер.Состояние()).Равно("ERROR");
	Ожидаем.Что(Провайдер.ВычислитьЛогическое("любой", Истина, Неопределено).Значение).ЭтоИстина();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Испорченный файл не роняет приложение")
Процедура ИспорченныйФайлНеЛоматПриложение() Экспорт

	Провайдер = Новый JsonFileProvider(ФайлФлагов("битый.json"));
	Провайдер.Инициализировать();

	Ожидаем.Что(Провайдер.Состояние()).Равно("ERROR");
	Ожидаем.Что(Провайдер.ВычислитьЛогическое("любой", Истина, Неопределено).КодОшибки).Равно(
		OpenFeatureErrorCode.ОшибкаРазбора());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Перечитывание подхватывает изменения файла")
Процедура ПеречитываниеПодхватываетИзменения() Экспорт

	// Провайдер должен увидеть изменение файла на диске, поэтому работаем
	// на копии: сама фикстура остаётся неизменной
	Путь = ПолучитьИмяВременногоФайла("json");
	КопироватьФайл(ФайлФлагов("выключено.json"), Путь);

	Попытка
		Провайдер = Новый JsonFileProvider(Путь);
		Провайдер.Инициализировать();

		Ожидаем.Что(Провайдер.ВычислитьЛогическое("включено", Истина, Неопределено).Значение).ЭтоЛожь();

		КопироватьФайл(ФайлФлагов("включено.json"), Путь);
		Провайдер.Перечитать();

		Ожидаем.Что(Провайдер.ВычислитьЛогическое("включено", Ложь, Неопределено).Значение).ЭтоИстина();
	Исключение
		УдалитьФайлы(Путь);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(Путь);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Вспомогательные

Функция ОписаниеФлагов()

	Варианты = Новый Соответствие();
	Варианты.Вставить("светлая", "light");
	Варианты.Вставить("тёмная", "dark");

	Правило = Новый Соответствие();
	Правило.Вставить("Атрибут", "plan");
	Правило.Вставить("Значения", СтрРазделить("pro,enterprise", ","));
	Правило.Вставить("Вариант", "тёмная");

	Правила = Новый Массив();
	Правила.Добавить(Правило);

	Тема = Новый Соответствие();
	Тема.Вставить("Варианты", Варианты);
	Тема.Вставить("ВариантПоУмолчанию", "светлая");
	Тема.Вставить("Правила", Правила);

	Выключенный = Новый Соответствие();
	Выключенный.Вставить("Значение", Истина);
	Выключенный.Вставить("Включен", Ложь);

	Объектный = Новый Соответствие();
	Объектный.Вставить("предел", 10);

	Результат = Новый Соответствие();
	Результат.Вставить("логический", Истина);
	Результат.Вставить("строковый", "значение");
	Результат.Вставить("числовой", 42);
	Результат.Вставить("объектный", Объектный);
	Результат.Вставить("тема", Тема);
	Результат.Вставить("выключенный", Выключенный);

	Возврат Результат;

КонецФункции

Функция ИзолированныйЭкземпляр()

	Экземпляр = OpenFeature.СоздатьИзолированныйЭкземпляр();
	Экземпляр.УстановитьПровайдер(Новый InMemoryProvider(ОписаниеФлагов()));

	Возврат Экземпляр;

КонецФункции

Функция КлиентСФлагами()

	Возврат ИзолированныйЭкземпляр().ПолучитьКлиента();

КонецФункции

// Наборы флагов лежат файлами в tests/fixtures/флаги: провайдер читает их
// с диска, поэтому фикстура должна быть настоящим файлом, а не строкой в коде.
//
Функция ФайлФлагов(Знач ИмяФайла)

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "флаги", ИмяФайла);

КонецФункции
